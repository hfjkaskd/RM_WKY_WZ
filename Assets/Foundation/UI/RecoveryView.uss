.panel { position: absolute; left: 24px; top: 24px; width: 500px; padding: 24px; background-color: rgb(24, 31, 47); color: rgb(230, 237, 245); border-radius: 14px; }
.eyebrow { color: rgb(129, 187, 225); font-size: 12px; margin-bottom: 12px; }
.title { font-size: 22px; white-space: normal; margin-bottom: 16px; }
.summary { font-size: 17px; margin-bottom: 12px; }
.note { white-space: normal; color: rgb(180, 194, 212); margin-bottom: 16px; }
Button { height: 40px; background-color: rgb(74, 132, 185); color: white; margin-bottom: 12px; border-radius: 6px; }
Label { margin-bottom: 6px; }

.panel { display: none; }
